# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-desktop
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Personal overrides only. `.env` itself is COMMITTED ON PURPOSE: it carries the
# client-safe Supabase URL and publishable key, and Vite bakes those in at BUILD
# time. Every zip shipped without it produced a build with no backend, which is
# what made the owner login screen vanish and the Super Admin login fail.
# Never add a bare `.env` or `.env*` rule here.
.env.local
.env.*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android (Capacitor)
# The project tree IS committed — it carries the manifest, the notification
# channel and the signing wiring, and regenerating it on every CI run would
# silently drop those. What is NOT committed is anything a build produces:
# Gradle's caches, the APKs, and the web bundle `cap sync` copies in (that is
# built from source by `npm run build:app`).
android/*/.gradle/
android/*/build/
android/*/app/build/
android/*/capacitor-cordova-android-plugins/build/
android/*/app/src/main/assets/public/
android/*/app/src/main/assets/capacitor.config.json
android/*/app/src/main/assets/capacitor.plugins.json
android/*/local.properties
# Signing material and Firebase credentials never belong in the repository.
android/**/*.keystore
android/**/*.jks
android/**/google-services.json
