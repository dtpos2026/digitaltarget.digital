# ============================================================
# Cloudflare Pages cache rules — v1.25.2
#
# THE FAILURE THIS PREVENTS
# "Failed to fetch dynamically imported module: .../SuperAdminPage-<hash>.js"
#
# Vite fingerprints every chunk. On each deploy the hashes change and the old
# files are gone. If the browser is allowed to cache index.html, it keeps
# asking for chunks from a build that no longer exists on the server — and the
# app dies at the first lazy import, which for this project is the Super Admin
# page. The code is fine; the browser is simply reading yesterday's map.
#
# Firebase Hosting used to set these headers via firebase.json. Moving to
# Cloudflare left them behind, and nothing replaced them.
#
# The rule is the mirror image for the two kinds of file:
#   • index.html and the service worker: NEVER cached — they are the map.
#   • hashed assets: cached forever — a new build means a new filename, so a
#     stale copy can never be served by mistake.
# ============================================================

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# Fingerprinted build output — safe to cache indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline security headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
