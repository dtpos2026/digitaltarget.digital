# ============================================================
# DT POS Enterprise — environment
# Copy to .env.local (which is gitignored) and fill in.
# ============================================================

# ---- Supabase (client-safe: these ship in the browser bundle) ----
VITE_SUPABASE_URL=https://drpzxzpvkpqfxcjbwypo.supabase.co
# Dashboard -> Settings -> API -> "Publishable key" (older projects: "anon public")
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy name, still accepted as a fallback:
# VITE_SUPABASE_ANON_KEY=

# ============================================================
# SERVER-SIDE ONLY — NEVER put these in a VITE_ variable, never
# in the Electron bundle, never committed.
#
# The service role key BYPASSES ROW LEVEL SECURITY COMPLETELY.
# If it reaches the frontend bundle, every tenant's data is
# readable by anyone who opens devtools.
# Used only by migration scripts and CI.
# ============================================================
# The SECRET / service_role key. NEVER give this a VITE_ prefix.
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.drpzxzpvkpqfxcjbwypo.supabase.co:5432/postgres
