# ============================================================================
# DT POS — Supabase configuration (COMMITTED ON PURPOSE)
#
# ===== WHY THIS FILE EXISTS AND MUST NOT BE DELETED =====
#
# Vite substitutes VITE_* variables at BUILD time, not at run time. When this
# file was missing, the produced bundle contained no Supabase configuration at
# all — and every one of these returned false:
#
#     isCloudConfigured()        (src/lib/cloudMode.ts)
#     supabaseAvailable()        (src/lib/authProvider.ts)
#     isSupabaseConfigured()     (src/lib/supabase.ts)
#
# The consequences, all of which were reported as separate bugs but are one:
#
#   1. App.tsx gates the owner/email login on `cloudMode`. With it false the
#      restaurant email screen NEVER RENDERED and the app went straight to the
#      staff PIN screen. ("email login nahi aa raha")
#   2. The Super Admin account lives only in Supabase. With Supabase judged
#      unavailable, sign-in was routed to the removed Firebase path, which
#      answers every password with an invalid-credentials error.
#      ("Invalid login credentials")
#
# Both keys below are CLIENT-SAFE. The publishable/anon key is designed to ship
# in a browser bundle; Row Level Security is what protects the data, not the
# secrecy of this key.
#
# NEVER add the service_role / secret key here or to any VITE_ variable —
# it bypasses RLS completely. src/lib/supabase.ts refuses to start if it
# detects one. Server-only values belong in .env.local or the host's secret
# store.
# ============================================================================

VITE_SUPABASE_URL=https://drpzxzpvkpqfxcjbwypo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wAdvU6MKlCyBCAMogNUdCQ_34DK6CVS

# Legacy JWT anon key. Kept as a fallback for any code path still reading the
# older variable name; either key works.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRycHp4enB2a3BxZnhjamJ3eXBvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYyMTkxMDQsImV4cCI6MjEwMTc5NTEwNH0.CQseQaHhy4-pjpqZFQxf32KE26l960QVGxXr00NbT34

# ---- Server-side names ---------------------------------------------------
# The Nitro server reads process.env under UN-PREFIXED names. Vite does not
# copy .env into process.env, so these are duplicated here for hosts that do
# load .env into the server process. Both are client-safe values.
SUPABASE_URL=https://drpzxzpvkpqfxcjbwypo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_wAdvU6MKlCyBCAMogNUdCQ_34DK6CVS

# ---- NOT HERE: the service_role key --------------------------------------
# Creating a restaurant owner's login (Super Admin -> add restaurant) calls
# supabaseAdmin.auth.admin.createUser(), which requires the SERVICE ROLE key.
# That key bypasses Row Level Security entirely.
#
# It does NOT belong in this file, because this file is committed and shipped.
# Put it in .env.local (gitignored) for local development:
#
#     SUPABASE_SERVICE_ROLE_KEY=<service_role key from the dashboard>
#
# and as an encrypted secret on your host for production.
# Supabase Dashboard -> Project Settings -> API Keys -> service_role
