# DT POS Enterprise — Windows build: where each setting lives.
# There is nothing to fill in for a normal build. Copy a line below only to override.

# --- read while BUILDING the POS bundle (digitaltarget.digital/.env already has the production values) ---
# VITE_SUPABASE_URL=https://<your-project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<publishable (anon) key — public by design, NOT the service key>

# --- read while PACKAGING the installer ---
# DTPOS_RENDERER=C:\path\to\another\client\bundle
# DT_ALLOW_SIGNING=1
# WIN_CSC_LINK=C:\path\to\certificate.pfx
# WIN_CSC_KEY_PASSWORD=<certificate password>

# --- read by the INSTALLED app at run time (set on the PC, not here) ---
# DTPOS_API_ORIGIN=https://digitaltarget.digital
